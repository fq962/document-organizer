# Copia este archivo a `.env.local` y completa los valores.
# Los encuentras en el dashboard de Supabase:
#   Project Settings → Data API  (URL)
#   Project Settings → API Keys  (llaves)

# --- Cliente (navegador) ---------------------------------------------------
# Las variables con prefijo NEXT_PUBLIC_ se incluyen en el bundle del cliente:
# solo pon aquí valores que pueden ser públicos.

# URL del proyecto, p. ej. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Llave publishable (sb_publishable_...). En proyectos antiguos es la "anon key".
# Es segura en el navegador siempre que las tablas y buckets tengan RLS activo.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bucket de Supabase Storage donde se guardan los documentos subidos.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=documents

# --- Servidor (nunca exponer) ----------------------------------------------
# Llave secreta (sb_secret_...). En proyectos antiguos es la "service_role key".
# Se salta RLS: úsala solo en código de servidor (route handlers, server
# actions) y NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Conexión directa a Postgres, solo si usas migraciones o un ORM.
# Project Settings → Database → Connection string.
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
